    <!-- Player settings screen -->
    <string name="player_settings_title">Ustawienia odtwarzacza</string>
    <string name="player_section_playback">Odtwarzanie</string>
    <string name="player_auto_frame_rate_label">Automatyczne dopasowanie częstotliwości klatek</string>
    <string name="player_auto_frame_rate_desc">Przełącza częstotliwość odświeżania ekranu, aby dopasować ją do treści (24fps, 30fps, 60fps). Zmniejsza drgania w filmach. Wyłącz, jeśli ekran migocze podczas uruchamiania odtwarzania.</string>
    <string name="player_smart_buffer_label">Inteligentne buforowanie</string>
    <string name="player_smart_buffer_desc">Zwiększa rozmiar bufora przy wolnych lub niestabilnych połączeniach. Poprawia stabilność kosztem nieco dłuższego czasu uruchamiania.</string>
    <string name="player_section_external_players">Zewnętrzne odtwarzacze</string>
    <string name="player_no_external_players">Nie wykryto zewnętrznych odtwarzaczy</string>
