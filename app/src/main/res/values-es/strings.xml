    <!-- Player settings screen -->
    <string name="player_settings_title">Ajustes del reproductor</string>
    <string name="player_section_playback">Reproducción</string>
    <string name="player_auto_frame_rate_label">Adaptación automática de frecuencia de fotogramas</string>
    <string name="player_auto_frame_rate_desc">Cambia la frecuencia de actualización de la pantalla para adaptarse al contenido (24fps, 30fps, 60fps). Reduce la fluctuación en películas. Desactiva si tu pantalla parpadea al iniciar la reproducción.</string>
    <string name="player_smart_buffer_label">Almacenamiento en búfer inteligente</string>
    <string name="player_smart_buffer_desc">Aumenta el tamaño del búfer en conexiones lentas o inestables. Mejora la estabilidad a costa de un tiempo de inicio ligeramente mayor.</string>
    <string name="player_section_external_players">Reproductores externos</string>
