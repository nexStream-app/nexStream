    <string name="player_storage_internal">Armazenamento interno</string>
    <string name="player_storage_browse">Procurar USB / cartão SD…</string>
    <string name="player_storage_current">Actual: %s</string>
    <string name="player_storage_dialog_title">Localização das transferências</string>
    <string name="player_storage_dialog_desc">Utilize o armazenamento interno ou seleccione uma pasta USB / cartão SD usando o explorador do sistema.</string>
    <string name="player_section_privacy">Privacidade</string>
    <string name="player_whisper_label">Legendas de IA (Whisper)</string>
    <string name="player_whisper_desc">Quando activado, o áudio é enviado para nexstream.uk para reconhecimento de voz no dispositivo. Desactive para evitar que qualquer áudio saia deste dispositivo.</string>
    <string name="player_whisper_autostart_label">Iniciar automaticamente na TV em directo</string>
    <string name="player_whisper_autostart_desc">Inicia automaticamente as legendas de IA quando abre um canal de TV em directo. Desactivado por defeito — pode sempre activá-las manualmente com o botão CC.</string>
    <string name="player_auto_lang_label">Detectar automaticamente áudio não inglês</string>
    <string name="player_auto_lang_desc">Na TV em directo, se a faixa de áudio seleccionada estiver num idioma diferente do inglês, ser-lhe-á perguntado se pretende adicionar legendas.</string>
    <string name="player_section_notifications">Notificações</string>
    <string name="player_admin_notifs_label">Anúncios do administrador</string>
    <string name="player_admin_notifs_desc">Mostrar banners na app para anúncios da equipa nexStream. Estes aparecem como um banner sobre o ecrã actual quando a app está aberta.</string>
    <string name="player_section_epg">EPG</string>
    <string name="player_epg_offset_label">Desvio de fuso horário</string>
    <string name="player_epg_offset_desc">Desloque os horários dos programas EPG se o seu fornecedor utilizar um fuso horário diferente. Ajuste em ±12 horas.</string>
    <string name="player_epg_offset_zero">0h (Desligado)</string>
    <string name="player_epg_dialog_title">Desvio de fuso horário EPG</string>
    <string name="player_epg_dialog_desc">Desloque os horários dos programas para corresponder ao horário do seu fornecedor. Use um valor positivo se os programas aparecem cedo, negativo se aparecem tarde.</string>
