    <string name="player_storage_location_label">Ubicación de almacenamiento</string>
    <string name="player_storage_location_desc">Donde se guardan las descargas y grabaciones.</string>
    <string name="player_storage_internal">Almacenamiento interno</string>
    <string name="player_storage_browse">Buscar USB / tarjeta SD…</string>
    <string name="player_storage_current">Actual: %s</string>
    <string name="player_storage_dialog_title">Ubicación de descargas</string>
    <string name="player_storage_dialog_desc">Usa el almacenamiento interno o selecciona una carpeta USB / tarjeta SD con el explorador del sistema.</string>
    <string name="player_section_privacy">Privacidad</string>
    <string name="player_whisper_label">Subtítulos de IA (Whisper)</string>
    <string name="player_whisper_desc">Cuando está activado, el audio se envía a nexstream.uk para el reconocimiento de voz en el dispositivo. Desactiva para evitar que cualquier audio salga de este dispositivo.</string>
    <string name="player_whisper_autostart_label">Iniciar automáticamente en TV en directo</string>
    <string name="player_whisper_autostart_desc">Inicia automáticamente los subtítulos de IA cuando abres un canal de TV en directo. Desactivado por defecto: siempre puedes activarlos manualmente con el botón CC.</string>
    <string name="player_auto_lang_label">Detectar automáticamente el audio no inglés</string>
    <string name="player_auto_lang_desc">En TV en directo, si la pista de audio seleccionada está en un idioma distinto al inglés, se te preguntará si quieres añadir subtítulos.</string>
    <string name="player_section_notifications">Notificaciones</string>
    <string name="player_admin_notifs_label">Anuncios de administrador</string>
    <string name="player_admin_notifs_desc">Mostrar banners en la app para los anuncios del equipo de nexStream. Aparecen como un banner sobre la pantalla actual cuando la app está abierta.</string>
    <string name="player_section_epg">EPG</string>
    <string name="player_epg_offset_label">Desplazamiento de zona horaria</string>
    <string name="player_epg_offset_desc">Desplaza los horarios de los programas EPG si tu proveedor usa una zona horaria diferente. Ajusta en ±12 horas.</string>
    <string name="player_epg_offset_zero">0h (Desactivado)</string>
    <string name="player_epg_dialog_title">Desplazamiento de zona horaria EPG</string>
    <string name="player_epg_dialog_desc">Desplaza los horarios de los programas para que coincidan con el horario de tu proveedor. Usa un valor positivo si los programas aparecen antes, negativo si aparecen tarde.</string>
