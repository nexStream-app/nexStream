    <string name="player_ext_movies">Filmy</string>
    <string name="player_ext_series">Seriale</string>
    <string name="player_ext_catchup">Nagrania</string>
    <string name="player_section_downloads">Pobieranie i nagrywanie</string>
    <string name="player_storage_location_label">Lokalizacja przechowywania</string>
    <string name="player_storage_location_desc">Miejsce, w którym są zapisywane pobrania i nagrania.</string>
    <string name="player_storage_internal">Pamięć wewnętrzna</string>
    <string name="player_storage_browse">Przeglądaj w poszukiwaniu USB / karty SD…</string>
    <string name="player_storage_current">Bieżący: %s</string>
    <string name="player_storage_dialog_title">Lokalizacja pobierania</string>
    <string name="player_storage_dialog_desc">Użyj pamięci wewnętrznej lub wybierz folder USB / karty SD za pomocą przeglądarki systemowej.</string>
    <string name="player_section_privacy">Prywatność</string>
    <string name="player_whisper_label">Napisy AI (Whisper)</string>
    <string name="player_whisper_desc">Po włączeniu dźwięk jest wysyłany do nexstream.uk w celu rozpoznawania mowy. Wyłącz, aby zapobiec wychodzeniu jakiegokolwiek dźwięku z tego urządzenia.</string>
    <string name="player_whisper_autostart_label">Automatyczne uruchamianie na TV na żywo</string>
    <string name="player_whisper_autostart_desc">Automatycznie uruchamia napisy AI po otwarciu kanału telewizji na żywo. Domyślnie wyłączone — zawsze możesz je włączyć ręcznie za pomocą przycisku CC.</string>
    <string name="player_auto_lang_label">Automatycznie wykrywaj dźwięk nieangielski</string>
    <string name="player_auto_lang_desc">Na TV na żywo, jeśli wybrana ścieżka audio jest w języku innym niż angielski, zostaniesz zapytany, czy chcesz dodać napisy.</string>
    <string name="player_section_notifications">Powiadomienia</string>
    <string name="player_admin_notifs_label">Ogłoszenia administratora</string>
    <string name="player_admin_notifs_desc">Pokaż banery w aplikacji dla ogłoszeń od zespołu nexStream. Pojawiają się jako baner nad bieżącym ekranem, gdy aplikacja jest otwarta.</string>
    <string name="player_section_epg">EPG</string>
    <string name="player_epg_offset_label">Przesunięcie strefy czasowej</string>
    <string name="player_epg_offset_desc">Przesuń czasy programów EPG, jeśli dostawca używa innej strefy czasowej. Dostosuj o ±12 godzin.</string>
    <string name="player_epg_offset_zero">0g (Wyłączone)</string>
    <string name="player_epg_dialog_title">Przesunięcie strefy czasowej EPG</string>
    <string name="player_epg_dialog_desc">Przesuń czasy programów, aby dopasować harmonogram dostawcy. Użyj wartości dodatniej, jeśli programy pojawiają się wcześniej, ujemnej jeśli pojawią się późno.</string>
    <string name="player_epg_decrease">Zmniejsz</string>
    <string name="player_epg_increase">Zwiększ</string>
