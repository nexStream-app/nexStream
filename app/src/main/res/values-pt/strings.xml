    <!-- Player settings screen -->
    <string name="player_settings_title">Definições do leitor</string>
    <string name="player_section_playback">Reprodução</string>
    <string name="player_auto_frame_rate_label">Correspondência automática de taxa de fotogramas</string>
    <string name="player_auto_frame_rate_desc">Muda a taxa de actualização do ecrã para corresponder ao conteúdo (24fps, 30fps, 60fps). Reduz a trepidação em filmes. Desactive se o ecrã piscar ao iniciar a reprodução.</string>
    <string name="player_smart_buffer_label">Buffer inteligente</string>
    <string name="player_smart_buffer_desc">Aumenta o tamanho do buffer em ligações lentas ou instáveis. Melhora a estabilidade à custa de um tempo de início ligeiramente mais longo.</string>
